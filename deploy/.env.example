# Пример окружения для dev/stage (docs/deploy.md §3).
# В git не коммитится: .env* в .gitignore. Скопируйте в deploy/.env и правьте.

SITEED_ADDR=0.0.0.0:8080
SITEED_ENV=dev
SITEED_STATIC=../frontend
# Пусто → memory-store прототипа; иначе postgres://siteed:***@postgres:5432/siteed
SITEED_DSN=
# Rust-ядро; пусто → встроенный cryptod-fallback.
CRYPTO_CORE_URL=http://crypto-core:8091
CRYPTO_CORE_TOKEN=dev-service-token
# KEK: 64 hex (32 байта). В проде — Vault Transit / KMS.
SITEED_KEK_HEX=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
REDIS_ADDR=redis:6379
JWT_PRIVATE_KEY=dev-ed25519-private-key-hex
JWT_KID=dev-2026
TG_BOT_TOKEN=dev-telegram-bot-token
SOLANA_RPC_URLS=https://api.devnet.solana.com
SOL_HOT_WALLET_ID=wlt_hot
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sitee
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
FEATURE_FLAGS=stars=on,e2ee=on,exchange=on
# Профиль нагрузки для прототипа: масштаб лимитов.
SITEED_RATE_SCALE=1
