# Rust crypto-core: библиотека + HTTP-сервис (docs/deploy.md §2.2).
FROM rust:1.78-bookworm AS build
WORKDIR /src
COPY crypto-core/ ./
# Внешних крейтов нет — cargo не обращается к сети.
RUN cargo build --release --offline --locked || cargo build --release
RUN strip target/release/crypto-core

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /src/target/release/crypto-core /crypto-core
USER 65534:65534
EXPOSE 8091
ENTRYPOINT ["/crypto-core", "0.0.0.0:8091"]
